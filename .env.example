# ─── GitHub App installation credentials (ADR 0001, Decision 2) ───────────────
#
# These three vars are the ONLY GitHub auth secrets used by this project.
# They are read exclusively by lib/github.ts at build / ISR time to fetch
# repo metadata via a GitHub App installation token (no expiry, no rotation).
#
# RULES (non-negotiable):
#   1. NEVER use the NEXT_PUBLIC_ prefix on any of these — that would inline
#      the values into the client bundle and ship them to every browser.
#   2. NEVER add any of these to next.config.js `env` block — every key there
#      is inlined client-side at build time regardless of variable name.
#   3. These vars are read in exactly ONE module: lib/github.ts. Do not
#      reference them (or their values) anywhere else.
#
# LOCAL SETUP:
#   Copy this file to .env.local (which is git-ignored) and fill in the values.
#   .env.local is already listed in .gitignore — do NOT commit real credentials.
#
# PRODUCTION:
#   Add the vars via your host's encrypted environment-variable store (e.g.
#   Vercel's "Environment Variables" UI). GitHub App installation tokens are
#   auto-renewed by the @octokit/auth-app strategy — no manual rotation needed.
#

# The numeric ID shown on your GitHub App's settings page
# (e.g. https://github.com/settings/apps/<your-app> → "App ID").
GITHUB_APP_ID=

# The installation ID for the cipher-codex org.
# Find it at: https://github.com/organizations/cipher-codex/settings/installations
# Click your app → the numeric ID is in the URL path.
GITHUB_APP_INSTALLATION_ID=

# The GitHub App private key (.pem file), base64-encoded for safe single-line
# storage in a .env file.
#
# How to encode (PowerShell):
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.pem"))
#
# How to encode (bash/macOS):
#   base64 -i key.pem | tr -d '\n'
#
# Paste the resulting single-line base64 string as the value below.
# lib/github.ts decodes it back to a PEM string at startup — the raw PEM
# never touches disk or the process environment in decoded form.
GITHUB_APP_PRIVATE_KEY_BASE64=

# ─── Existing public config (safe to expose — these are NOT secrets) ──────────
# projects_per_page=10
# api_url=
